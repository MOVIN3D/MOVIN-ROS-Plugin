<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>movin_g1_description</name>
  <version>2.0.0</version>
  <description>Unitree G1 (29 DoF) URDF, meshes and RViz configuration used by the optional MOVIN retargeting pipeline</description>
  <maintainer email="dk.jang@movin3d.com">DK Jang</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/MOVIN3D/MOVIN-ROS-Plugin</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend condition="$MOVIN_HEADLESS != 1">rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
